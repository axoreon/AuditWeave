DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
CREDIT_RESERVATION_TIMEOUT_MINUTES=360
JWT_SECRET=replace_me
GEMINI_API_KEY=replace_me
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
RESEND_API_KEY=re_placeholder
CONTACT_ADMIN_EMAIL=support@example.com
CONTACT_FROM_EMAIL=AuditWeave <noreply@example.com>
RECEIPT_EMAIL_FROM=AuditWeave <receipts@example.com>
# Optional outside Docker; font must contain the Indian rupee glyph.
# RECEIPT_FONT_PATH=/path/to/DejaVuSans.ttf
# RECEIPT_FONT_BOLD_PATH=/path/to/DejaVuSans-Bold.ttf

# --- Email OTP (signup verification) ---
# Required for new user signup email verification.
# Supports any SMTP provider (Gmail, Mailgun, SendGrid, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AuditWeave
# Set to false only if connecting to a local/dev SMTP server without TLS
SMTP_USE_TLS=true
